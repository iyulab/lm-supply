<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- Core Dependencies -->
    <!--
      onnxruntime 1.25.x-1.26.0 crashed InferenceSession construction for the Transcriber's
      zero-config registry default (whisper-base, decoder_model_merged_int8.onnx, CPU EP) with
      "Missing required scale: ...embed_tokens.weight_merged_0_scale". 1.30.0 loads and
      transcribes it again. Before changing this version, run the registry-default models through
      LMSupply.Integration.Tests' Functional/LocalOnly suites (network + GPU required, not part
      of CI).
    -->
    <PackageVersion Include="Microsoft.ML.OnnxRuntime" Version="1.30.0" />
    <PackageVersion Include="Microsoft.ML.Tokenizers" Version="2.0.0" />
    <PackageVersion Include="System.Numerics.Tensors" Version="10.0.12" />
    <!-- Vision Dependencies -->
    <PackageVersion Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageVersion Include="SixLabors.ImageSharp.Drawing" Version="2.1.7" />
    <!-- Audio Dependencies -->
    <PackageVersion Include="NAudio" Version="3.0.1" />
    <PackageVersion Include="NAudio.Lame" Version="2.1.0" />
    <!-- Pure-managed MP3 decoder for NAudio 3.0's cross-platform build, which no longer bundles
         one — version-locked to NAudio.Core 3.0.1 per its own
         release notes. -->
    <PackageVersion Include="NLayer.NAudioSupport" Version="3.0.0" />
    <!-- Pure-managed Opus decoder: audio recorded in a browser (MediaRecorder WebM/Opus, Ogg/Opus) is decoded without a
         native library, the same cross-platform stance as NLayer above. -->
    <PackageVersion Include="Concentus" Version="2.2.2" />
    <PackageVersion Include="MathNet.Numerics" Version="5.0.0" />
    <!-- ONNX Runtime GenAI for LLM Inference -->
    <PackageVersion Include="Microsoft.ML.OnnxRuntimeGenAI" Version="0.13.2" />
    <!-- llama-server process management -->
    <PackageVersion Include="ChildProcessGuard" Version="1.1.1" />
    <!-- GPU Providers (optional, user installs separately) -->
    <PackageVersion Include="Microsoft.ML.OnnxRuntime.Gpu" Version="1.30.0" />
    <!-- Testing (xUnit v3 / Microsoft.Testing.Platform) -->
    <PackageVersion Include="xunit.v3" Version="4.0.0" />
    <PackageVersion Include="Iyu.Conventions.Testing" Version="0.4.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageVersion Include="Microsoft.Testing.Extensions.HangDump" Version="2.3.3" />
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <!-- Benchmarking -->
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <!-- Build Tooling -->
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.401" />
    <!-- Console Host -->
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="10.1.7" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.12" />
    <!-- The M.E.AI embedding contract LMSupply.Embedder implements. Held with the ecosystem line (10.9.x). -->
    <PackageVersion Include="Microsoft.Extensions.AI.Abstractions" Version="10.10.1" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12" />
    <!--
      DO NOT BUMP to 3.x until Microsoft.AspNetCore.OpenApi's XmlCommentGenerator
      is updated upstream. Microsoft.OpenApi 3.x made IOpenApiMediaType.Example
      read-only (JsonNode? getter), but the ASP.NET Core 10 source generator
      (as of 10.0.8) still assigns to it, producing CS0200 at build time.
      Keep on 2.x — Microsoft.AspNetCore.OpenApi 10.0.12 requires >= 2.12.0 (< 3.0.0).
      See commit de95363 for the original fix.
    -->
    <PackageVersion Include="Microsoft.OpenApi" Version="2.12.2" />
    <!--
      Explicit lift: Microsoft.EntityFrameworkCore.Sqlite 10.0.8 pulls SQLitePCLRaw
      2.1.11 (NU1903 high, GHSA-2m69-gcr7-jv3q).
      Remove once EFCore.Sqlite's transitive floor reaches 2.1.12.
    -->
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
  </ItemGroup>
</Project>