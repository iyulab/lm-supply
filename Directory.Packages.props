<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- Core Dependencies -->
    <!--
      onnxruntime 1.25.x-1.26.0 crashed InferenceSession construction for the Transcriber's
      zero-config registry default (whisper-base, decoder_model_merged_int8.onnx, CPU EP) with
      "Missing required scale: ...embed_tokens.weight_merged_0_scale". 1.30.0 and later load and
      transcribes it again. Before changing this version, run the registry-default models through
      LMSupply.Integration.Tests' Functional/LocalOnly suites (network + GPU required, not part
      of CI).
    -->
    <PackageVersion Include="Microsoft.ML.OnnxRuntime" Version="1.31.0" />
    <PackageVersion Include="Microsoft.ML.Tokenizers" Version="2.0.1" />
    <PackageVersion Include="System.Numerics.Tensors" Version="10.0.13" />
    <!-- Vision Dependencies -->
    <PackageVersion Include="SkiaSharp" Version="4.153.1" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.153.1" />
    <!-- Audio Dependencies -->
    <PackageVersion Include="NAudio" Version="3.3.0" />
    <PackageVersion Include="NAudio.Lame" Version="2.1.0" />
    <!-- Pure-managed MP3 decoder for NAudio 3's cross-platform build, which no longer bundles one. It is built
         against NAudio.Core 3.0.1 and asks for that version or later, so it does not hold NAudio back. -->
    <PackageVersion Include="NLayer.NAudioSupport" Version="3.0.0" />
    <!-- Pure-managed Opus decoder: audio recorded in a browser (MediaRecorder WebM/Opus, Ogg/Opus) is decoded without a
         native library, the same cross-platform stance as NLayer above. -->
    <PackageVersion Include="Concentus" Version="2.2.2" />
    <PackageVersion Include="MathNet.Numerics" Version="5.0.0" />
    <!-- ONNX Runtime GenAI for LLM Inference. The 0.x API changes between minors, and the generator paths are covered
         only by the integration and local-model suites, which CI does not run: move it only after those suites pass on
         the new version on a GPU machine. -->
    <PackageVersion Include="Microsoft.ML.OnnxRuntimeGenAI" Version="0.18.0" />
    <!-- llama-server process management -->
    <PackageVersion Include="ChildProcessGuard" Version="1.4.0" />
    <!-- GPU Providers (optional, user installs separately) -->
    <PackageVersion Include="Microsoft.ML.OnnxRuntime.Gpu" Version="1.31.0" />
    <!-- Testing (xUnit v3 / Microsoft.Testing.Platform) -->
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="Iyu.Conventions.Testing" Version="0.13.0" />
    <PackageVersion Include="Iyu.Conventions.Testing.Snippets" Version="0.13.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="Microsoft.Testing.Extensions.HangDump" Version="2.5.1" />
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
    <!-- Benchmarking -->
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <!-- Build Tooling -->
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.401" />
    <!-- Console Host -->
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="10.3.1" />
    <PackageVersion Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.13" />
    <!-- The M.E.AI contracts LMSupply.Embedder (IEmbeddingGenerator) and LMSupply.Generator (IChatClient) implement. -->
    <PackageVersion Include="Microsoft.Extensions.AI.Abstractions" Version="10.11.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13" />
    <!--
      Held on 2.x: Swashbuckle.AspNetCore 10.x is built against Microsoft.OpenApi 2.x (its dependency is >= 2.7.5),
      and 3.x changed the object model it writes (IOpenApiMediaType.Example became read-only, among others).
      Move to 3.x with the Swashbuckle release that targets it; it is a major version, so the bump is a maintainer's.
      The console host uses it directly for the Bearer security scheme (console/host/Program.cs).
    -->
    <PackageVersion Include="Microsoft.OpenApi" Version="2.12.2" />
  </ItemGroup>
</Project>