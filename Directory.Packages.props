<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- Core Dependencies -->
    <!--
      Pinned below the latest (1.26.0): 1.25.1 and 1.26.0 both crash
      InferenceSession construction for this package's own zero-config registry default
      (onnx-community/whisper-base, decoder_model_merged_int8.onnx, CPU EP) with
      "Missing required scale: ...embed_tokens.weight_merged_0_scale" — an onnxruntime
      native regression somewhere in the 1.24.4->1.25.x range, bisected directly against
      the native onnxruntime.dll with the same managed code and cached model file
      unchanged. 1.24.1 through 1.24.4 all load and transcribe cleanly; 1.24.4 is also
      what RuntimeManager's own provisioning cache already carries. Do not bump past
      1.24.4 without first running the registry-default model through
      LMSupply.Integration.Tests' Functional/LocalOnly Transcriber suite (network+GPU
      required, not part of CI) — see docket iyulab/lm-supply#151.
    -->
    <PackageVersion Include="Microsoft.ML.OnnxRuntime" Version="1.24.4" />
    <PackageVersion Include="Microsoft.ML.Tokenizers" Version="2.0.0" />
    <PackageVersion Include="System.Numerics.Tensors" Version="10.0.8" />
    <!-- Vision Dependencies -->
    <PackageVersion Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageVersion Include="SixLabors.ImageSharp.Drawing" Version="2.1.7" />
    <!-- Audio Dependencies -->
    <PackageVersion Include="NAudio" Version="3.0.1" />
    <PackageVersion Include="NAudio.Lame" Version="2.1.0" />
    <PackageVersion Include="MathNet.Numerics" Version="5.0.0" />
    <!-- ONNX Runtime GenAI for LLM Inference -->
    <PackageVersion Include="Microsoft.ML.OnnxRuntimeGenAI" Version="0.13.2" />
    <PackageVersion Include="Microsoft.ML.OnnxRuntimeGenAI.Cuda" Version="0.11.3" />
    <PackageVersion Include="Microsoft.ML.OnnxRuntimeGenAI.DirectML" Version="0.11.3" />
    <!-- llama-server process management -->
    <PackageVersion Include="ChildProcessGuard" Version="1.1.1" />
    <!-- GPU Providers (optional, user installs separately) -->
    <PackageVersion Include="Microsoft.ML.OnnxRuntime.Gpu" Version="1.29.0" />
    <PackageVersion Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.23.2" />
    <!-- Testing (xUnit v3 / Microsoft.Testing.Platform — BD-20260829-xunit-v3-pilot rollout) -->
    <PackageVersion Include="xunit.v3" Version="4.0.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageVersion Include="Microsoft.Testing.Extensions.HangDump" Version="2.3.3" />
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.8" />
    <!-- Benchmarking -->
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <!-- Build Tooling -->
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.103" />
    <!-- Console Host -->
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="10.1.7" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.8" />
    <PackageVersion Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.8" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.8" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.8" />
    <!--
      DO NOT BUMP to 3.x until Microsoft.AspNetCore.OpenApi's XmlCommentGenerator
      is updated upstream. Microsoft.OpenApi 3.x made IOpenApiMediaType.Example
      read-only (JsonNode? getter), but the ASP.NET Core 10 source generator
      (as of 10.0.8) still assigns to it, producing CS0200 at build time.
      Keep pinned to 2.7.x. See commit de95363 for the original fix.
    -->
    <PackageVersion Include="Microsoft.OpenApi" Version="2.7.6" />
    <!--
      Explicit lift: Microsoft.EntityFrameworkCore.Sqlite 10.0.8 pulls SQLitePCLRaw
      2.1.11 (NU1903 high, GHSA-2m69-gcr7-jv3q). Same pattern as FluxIndex cycle-171.
      Remove once EFCore.Sqlite's transitive floor reaches 2.1.12.
    -->
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
  </ItemGroup>
</Project>