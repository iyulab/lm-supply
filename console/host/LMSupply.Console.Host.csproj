<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>LMSupply.Console.Host</RootNamespace>
    <IsPackable>false</IsPackable>
    <AssemblyName>lm-supply</AssemblyName>
    <!-- 임베디드 파일 매니페스트 생성 (ManifestEmbeddedFileProvider용) -->
    <!-- wwwroot는 npm build로 생성되므로, 폴더가 없으면 매니페스트 생성을 건너뜀 -->
    <GenerateEmbeddedFilesManifest Condition="Exists('wwwroot')">true</GenerateEmbeddedFilesManifest>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LMSupply.Integration.Tests" />
  </ItemGroup>

  <!-- wwwroot 파일을 임베디드 리소스로 포함 (단일 실행파일에 포함) -->
  <ItemGroup Condition="Exists('wwwroot')">
    <EmbeddedResource Include="wwwroot\**" />
    <Content Remove="wwwroot\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- LMSupply References -->
    <ProjectReference Include="..\..\src\LMSupply.Core\LMSupply.Core.csproj" />
    <ProjectReference Include="..\..\src\LMSupply.Generator\LMSupply.Generator.csproj" />
    <ProjectReference Include="..\..\src\LMSupply.Generator.Onnx\LMSupply.Generator.Onnx.csproj" />
    <ProjectReference Include="..\..\src\LMSupply.Embedder\LMSupply.Embedder.csproj" />
    <ProjectReference Include="..\..\src\LMSupply.Reranker\LMSupply.Reranker.csproj" />
    <ProjectReference Include="..\..\src\LMSupply.Transcriber\LMSupply.Transcriber.csproj" />
    <ProjectReference Include="..\..\src\LMSupply.Synthesizer\LMSupply.Synthesizer.csproj" />
    <ProjectReference Include="..\..\src\LMSupply.Captioner\LMSupply.Captioner.csproj" />
    <ProjectReference Include="..\..\src\LMSupply.Ocr\LMSupply.Ocr.csproj" />
    <ProjectReference Include="..\..\src\LMSupply.Detector\LMSupply.Detector.csproj" />
    <ProjectReference Include="..\..\src\LMSupply.Segmenter\LMSupply.Segmenter.csproj" />
    <ProjectReference Include="..\..\src\LMSupply.Translator\LMSupply.Translator.csproj" />
    <ProjectReference Include="..\..\src\LMSupply.ImageGenerator\LMSupply.ImageGenerator.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- OpenAPI/Swagger -->
    <PackageReference Include="Swashbuckle.AspNetCore" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <!-- Audio conversion -->
    <PackageReference Include="NAudio.Lame" />
    <!-- EF Core SQLite for API key storage -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <!-- NU1903 lift for transitive SQLitePCLRaw 2.1.11 — see Directory.Packages.props -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.OpenApi" />
    <!-- 임베디드 정적 파일 제공 — ManifestEmbeddedFileProvider의 manifest XML 생성에 필요 -->
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" />
  </ItemGroup>

</Project>
