<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Package Metadata -->
    <PackageId>LMSupply.Generator</PackageId>
    <Description>A .NET library for local LLM text generation via GGUF/llama-server, with streaming, chat templates, and automatic hardware-aware backend selection. Add LMSupply.Generator.Onnx for ONNX Runtime GenAI models (Phi, etc.).</Description>
    <PackageTags>llm;ai;ml;gguf;llama;text-generation;chatbot;phi;gpu;cuda;directml;streaming</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- Build Settings -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LMSupply.Generator.Tests" />
    <!-- The optional ONNX Runtime GenAI backend needs IDiagnosticsSink / ToolCallTextParser,
         which stay internal here rather than becoming public surface. -->
    <InternalsVisibleTo Include="LMSupply.Generator.Onnx" />
    <InternalsVisibleTo Include="LMSupply.Generator.Onnx.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LMSupply.Core\LMSupply.Core.csproj" />
    <ProjectReference Include="..\LMSupply.Llama\LMSupply.Llama.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
