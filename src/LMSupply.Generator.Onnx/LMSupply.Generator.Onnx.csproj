<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Package Metadata -->
    <PackageId>LMSupply.Generator.Onnx</PackageId>
    <Description>ONNX Runtime GenAI backend for LMSupply.Generator. Adds local text generation on ONNX models (Phi, etc.) with CUDA GPU acceleration. Optional — LMSupply.Generator works with GGUF/llama-server alone without this package.</Description>
    <PackageTags>llm;ai;ml;onnx;text-generation;chatbot;phi;gpu;cuda;streaming</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- Build Settings -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LMSupply.Generator.Onnx.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LMSupply.Generator\LMSupply.Generator.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- ONNX Runtime GenAI - CPU only by default, GPU packages installed separately -->
    <!-- ExcludeAssets="native" ensures native binaries are downloaded on-demand via RuntimeManager -->
    <PackageReference Include="Microsoft.ML.OnnxRuntimeGenAI" ExcludeAssets="native" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <!-- Exclude native runtimes from NuGet package - they will be lazy-loaded -->
  <ItemGroup>
    <None Remove="runtimes\**\*" />
  </ItemGroup>

  <Target Name="ExcludeNativeAssets" BeforeTargets="GenerateNuspec">
    <ItemGroup>
      <_PackageFiles Remove="@(_PackageFiles)" Condition="$([System.String]::Copy('%(Identity)').Contains('runtimes'))" />
    </ItemGroup>
  </Target>

  <!-- The GenAI managed assembly carries no version (0.0.0.0); stamp the centrally pinned GenAI version so the backend can
       provision the matching native runtime when the application has no deps.json to read it from. -->
  <Target Name="StampOnnxRuntimeGenAIVersion" BeforeTargets="GetAssemblyAttributes">
    <ItemGroup>
      <_GenAiPin Include="@(PackageVersion)" Condition="'%(Identity)' == 'Microsoft.ML.OnnxRuntimeGenAI'" />
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>OnnxRuntimeGenAIVersion</_Parameter1>
        <_Parameter2>@(_GenAiPin->'%(Version)')</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
    <Error Condition="'@(_GenAiPin)' == ''" Text="No central PackageVersion for Microsoft.ML.OnnxRuntimeGenAI." />
  </Target>
</Project>
