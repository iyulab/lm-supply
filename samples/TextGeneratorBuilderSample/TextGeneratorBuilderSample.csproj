<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\LMSupply.Generator\LMSupply.Generator.csproj" />
    <!-- The "Default" preset routes to ONNX on a discrete non-NVIDIA Windows GPU; this sample
         exists specifically to exercise ONNX runtime download, so it needs the backend. -->
    <ProjectReference Include="..\..\src\LMSupply.Generator.Onnx\LMSupply.Generator.Onnx.csproj" />
  </ItemGroup>

  <!--
    No native packages needed!
    ONNX Runtime GenAI binaries are downloaded on-demand from NuGet.org at runtime.
    This sample tests the fix for DllNotFoundException when using TextGeneratorBuilder.
  -->

</Project>
