<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- LMSUPPLY001: The synthesizer's own tests. Only this id; removed when the synthesizer leaves [Experimental]. -->
    <NoWarn>$(NoWarn);LMSUPPLY001</NoWarn>
    <!-- Run like a trimmed/AOT host: every JSON read/write in the code under test must resolve through source-generated
         metadata. A type left out of a JsonSerializerContext fails here instead of in a consumer's AOT app. -->
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- xUnit v3 test projects are stand-alone executables -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.Testing.Extensions.HangDump" />
    <PackageReference Include="AwesomeAssertions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\LMSupply.Core\LMSupply.Core.csproj" />
    <ProjectReference Include="..\..\src\LMSupply.Synthesizer\LMSupply.Synthesizer.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
