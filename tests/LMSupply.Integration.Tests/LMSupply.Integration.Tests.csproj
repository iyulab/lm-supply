<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- LMSUPPLY001: These tests exercise the experimental synthesizer, including the intelligibility fact that stays red until G2P lands. Only this id; removed when the synthesizer leaves [Experimental]. -->
    <NoWarn>$(NoWarn);LMSUPPLY001</NoWarn>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- xUnit v3 test projects are stand-alone executables -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.Testing.Extensions.HangDump" />
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="NAudio" />
    <PackageReference Include="NAudio.Lame" />
    <!-- README snippet compile teeth -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\console\host\LMSupply.Console.Host.csproj" />
    <ProjectReference Include="..\..\src\LMSupply.Embedder\LMSupply.Embedder.csproj" />
    <ProjectReference Include="..\..\src\LMSupply.Reranker\LMSupply.Reranker.csproj" />
    <ProjectReference Include="..\..\src\LMSupply.Generator\LMSupply.Generator.csproj" />
    <ProjectReference Include="..\..\src\LMSupply.Generator.Onnx\LMSupply.Generator.Onnx.csproj" />
    <ProjectReference Include="..\..\src\LMSupply.Llama\LMSupply.Llama.csproj" />
    <ProjectReference Include="..\..\src\LMSupply.Translator\LMSupply.Translator.csproj" />
    <ProjectReference Include="..\..\src\LMSupply.Transcriber\LMSupply.Transcriber.csproj" />
    <ProjectReference Include="..\..\src\LMSupply.Synthesizer\LMSupply.Synthesizer.csproj" />
    <ProjectReference Include="..\..\src\LMSupply.Captioner\LMSupply.Captioner.csproj" />
    <ProjectReference Include="..\..\src\LMSupply.Ocr\LMSupply.Ocr.csproj" />
    <ProjectReference Include="..\..\src\LMSupply.Detector\LMSupply.Detector.csproj" />
    <ProjectReference Include="..\..\src\LMSupply.Segmenter\LMSupply.Segmenter.csproj" />
    <ProjectReference Include="..\..\src\LMSupply.ImageGenerator\LMSupply.ImageGenerator.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Functional\Goldens\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="AwesomeAssertions" />
  </ItemGroup>

</Project>
